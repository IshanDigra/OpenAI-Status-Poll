# Core Monitor Settings
FEED_URL=https://status.openai.com/history.atom
POLL_INTERVAL_SECONDS=60

# State Management Backend ("file" or "gcs")
STATE_BACKEND=file
STATE_FILE_PATH=state.json

# GCS State Backend (if STATE_BACKEND=gcs)
GCS_BUCKET_NAME=your-bucket-name
GCS_STATE_BLOB_NAME=openai_status_state.json

# Notifiers (comma-separated: console, slack, email)
NOTIFIERS=console

# Slack Notifier
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email Notifier
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=recipient@example.com

# Logging
LOG_LEVEL=INFO
